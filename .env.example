# Configuration locale Qonto
QONTO_API_KEY=remplacer-par-votre-cle-qonto
QONTO_ORGANIZATION_ID=remplacer-par-votre-identifiant

# Microsoft Foundry / Azure OpenAI, appelé côté serveur uniquement
# Copiez exactement l’endpoint du déploiement, par exemple :
# https://votre-ressource.openai.azure.com/
FOUNDRY_ENDPOINT=https://votre-ressource.openai.azure.com/
FOUNDRY_API_KEY=remplacer-par-votre-cle-foundry
# Identifiant métier de l’agent, utilisé dans ses instructions serveur
FOUNDRY_AGENT_ID=assistant-financier
# Nom exact du déploiement de modèle disponible dans le projet Foundry
FOUNDRY_MODEL_DEPLOYMENT=nom-du-deploiement
# Facultatif : 1 000 à 120 000 ms (défaut 30 000)
FOUNDRY_TIMEOUT_MS=30000
# Facultatif : 1 à 12 appels d’outils par tour (défaut 6)
FOUNDRY_MAX_TOOL_CALLS=6
